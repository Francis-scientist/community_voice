<?xml version="1.0" encoding="utf-8"?>
<!--
  This file is merged into the manifest for DEBUG builds only.

  It is what allows the app to talk to your computer over plain http://
  during local development. Release builds do not get these attributes,
  so a released app can only use https:// - which is what you want.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true" />

</manifest>
