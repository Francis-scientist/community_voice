<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon fallback for Android 7.x (API 24-25), which has no
     adaptive-icon support: the green background with the bubble on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</layer-list>
